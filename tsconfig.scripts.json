{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode (run directly by Node's type stripping) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "scripts/**/*.ts",
    "src/features/game-data/engine/**/*.ts",
    "src/features/game-data/build/**/*.ts",
    "src/features/guide/engine/**/*.ts",
    "src/features/guide/build/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts", "scripts/**/*.test.ts", "src/features/game-data/engine/browser", "src/features/guide/engine/browser"]
}
