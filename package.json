{
  "name": "d2r-esr-runeword-browser",
  "private": true,
  "version": "1.70.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "prettier:format-check": "prettier --check .",
    "prettier:format-fix": "prettier --write .",
    "prepare": "husky",
    "release": "npm run lint && npm run build && commit-and-tag-version -a",
    "compiler:check": "eslint ./src --rule 'react-hooks/incompatible-library: error' --rule 'react-hooks/unsupported-syntax: error'",
    "compiler:health": "npx react-compiler-healthcheck@latest --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:fixtures": "node scripts/fetch-test-fixtures.js",
    "socketables:names": "node scripts/extract-socketable-names.js",
    "version:extract": "node scripts/extract-version.js",
    "game-data:generate": "node scripts/generate-game-data.ts",
    "game-data:check": "node scripts/generate-game-data.ts --check && node scripts/generate-item-icons.ts --check && node scripts/generate-skill-icons.ts --check",
    "game-data:icons": "node scripts/generate-item-icons.ts && node scripts/generate-game-data.ts && node scripts/generate-skill-icons.ts",
    "game-data:skill-icons": "node scripts/generate-skill-icons.ts",
    "game-data:update": "node scripts/update-game-data.ts",
    "modifiers:refs": "node scripts/generate-modifier-refs.ts",
    "esr:diff": "node scripts/esr-release-diff.ts",
    "esr:review": "node scripts/esr-update-review.ts",
    "esr:changelog": "node scripts/esr-changelog-check.ts",
    "esr:user-data": "node scripts/check-user-data.ts",
    "guide:generate": "node scripts/generate-guide.ts",
    "guide:check": "node scripts/generate-guide.ts --check",
    "guide:watch": "node scripts/generate-guide.ts --watch",
    "guide:verify": "node scripts/generate-guide.ts verify",
    "guide:report": "node scripts/generate-guide.ts report",
    "check:loot-filter-sharing": "node scripts/check-loot-filter-sharing.ts",
    "loot-filter:icons": "node scripts/generate-loot-filter-icons.ts",
    "loot-filter:agent-pack": "node scripts/generate-loot-filter-agent-pack.ts",
    "loot-filter:template": "node scripts/update-sully-template.ts"
  },
  "commit-and-tag-version": {
    "scripts": {
      "postbump": "npm run version:extract && git add src/assets/version.json"
    },
    "tagPrefix": "v",
    "commitUrlFormat": "https://github.com/istvan-panczel/d2r-esr-runeword-browser/commit/{{hash}}",
    "compareUrlFormat": "https://github.com/istvan-panczel/d2r-esr-runeword-browser/compare/{{previousTag}}...{{currentTag}}",
    "issueUrlFormat": "https://github.com/istvan-panczel/d2r-esr-runeword-browser/issues/{{id}}",
    "userUrlFormat": "https://github.com/{{user}}",
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "perf",
        "section": "Performance"
      },
      {
        "type": "revert",
        "section": "Reverts"
      },
      {
        "type": "docs",
        "section": "Documentation"
      },
      {
        "type": "style",
        "section": "Styles"
      },
      {
        "type": "chore",
        "section": "Chores"
      },
      {
        "type": "refactor",
        "section": "Refactoring"
      },
      {
        "type": "test",
        "section": "Tests"
      },
      {
        "type": "build",
        "section": "Build"
      },
      {
        "type": "ci",
        "section": "CI"
      }
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{js,jsx,mjs,cjs,json,css,md,html,yml,yaml}": [
      "prettier --write"
    ],
    "*.{png,jpg,jpeg,webp,pdf}": [
      "sh scripts/check-metadata.sh"
    ]
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@reduxjs/toolkit": "^2.11.2",
    "@supabase/supabase-js": "^2.107.0",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "lucide-react": "^1.63.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.11.0",
    "redux-saga": "^1.4.2",
    "reselect": "^5.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/babel__core": "^7.20.5",
    "@types/d3-force": "^3.0.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-dom": "^5.28.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^5.28.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "prettier": "^3.7.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "fsevents": false
  }
}
