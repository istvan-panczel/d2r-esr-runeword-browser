    {"code":"33p","name":"Greater Elixir of the Gorilla","slug":"greater-elixir-of-the-gorilla","variant":"greater","state":"elixirofthegorilla","tooltip":"Grants +%d%% Bonus to Vitality and Total Defense Bonus for 45 seconds","tooltipFormula":"(5+stat('level'.accr)/4)*125*(100+stat('utilitypotionmultiplier'.accr)+(stat('alchemy_2'.accr)>0)*5)/10000","effects":[{"lines":["+{v}% Total Defense","+{v}% Bonus to Vitality"],"formula":"(5+stat('level'.accr)/4)*125*(100+stat('utilitypotionmultiplier'.accr)+(stat('alchemy_2'.accr)>0)*5)/10000","stats":["vitalitypercent","armor_override_percent"],"values":[6,40]}],"duration":"1125*(100+stat('utilitypotionduration'.accr))/100","seconds":45,"pair":"16p","dropPerks":["alchemy_12","alchemy_4"],"recipes":[2309]},
    {"code":"34p","name":"Greater Elixir of the Raven","slug":"greater-elixir-of-the-raven","variant":"greater","state":"elixiroftheraven","tooltip":"Grants +%d%% Bonus to Energy and Skill Cooldown Reduction for 45 seconds","tooltipFormula":"(5+stat('level'.accr)/4)*125*(100+stat('utilitypotionmultiplier'.accr)+(stat('alchemy_2'.accr)>0)*5)/10000","effects":[{"lines":["+{v}% Skill Cooldown Reduction","+{v}% Bonus to Energy"],"formula":"(5+stat('level'.accr)/4)*125*(100+stat('utilitypotionmultiplier'.accr)+(stat('alchemy_2'.accr)>0)*5)/10000","stats":["energypercent","item_skill_cooldown"],"values":[6,40]}],"duration":"1125*(100+stat('utilitypotionduration'.accr))/100","seconds":45,"pair":"17p","dropPerks":["alchemy_12","alchemy_4"],"recipes":[2309]},
