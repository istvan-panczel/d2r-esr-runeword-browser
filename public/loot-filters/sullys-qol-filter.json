    {"comment": "R002 | Ethereal normal weapons with 0 or 2+ sockets: never hidden at L1 | never hide at L1", "itemTypes": ["weap"], "baseTier": 0, "isEthereal": true, "sockets": [0, 2, 3, 4, 5, 6], "activeInLevels": [1], "show": true},
