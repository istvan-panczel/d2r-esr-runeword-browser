    // ---- Skill bases
    // Bases with +All Skills, +1 Summons Limit or +3 or more to a skill tab are never hidden.

    {
      "comment": "R006 | White and superior armor/weapons with +All Skills: never hidden | never hide",
      "itemTypes": ["armo", "weap"],
      "quality": ["normal", "superior"],
      "itemStats": [{"stat": "item_allskills", "op": ">=", "value": 1}],
      "show": true
