# npm 12 defaults allow-remote=none, which makes dry-run and --package-lock-only resolves fail with
# EALLOWREMOTE on the Tailwind wasm32-wasi fallback tarball (plain install/ci/update are unaffected).
# "all" restores the pre-npm-12 behaviour; the lockfile's integrity hashes still pin every tarball.
# Older npm versions ignore this key.
allow-remote=all

# Supply-chain cooldown: only install versions published more than 7 days ago. Compromised releases (stolen
# maintainer tokens, self-spreading install-script worms) are usually caught and unpublished within hours to days.
# For an urgent security fix, read its diff, add a `min-release-age-exclude[]=<package>` line, update, then remove
# the line again. `npm install`, `npm update` and `npm outdated` respect the window.
min-release-age=7
